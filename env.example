HOST=127.0.0.1
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# MCP 2026-07-28 candidate endpoint
MCP_NAME=resend-mcp
MCP_TITLE=Resend
MCP_VERSION=1.0.0
MCP_PUBLIC_URL=http://localhost:3000/mcp
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
MCP_ALLOWED_ORIGIN_HOSTNAMES=localhost,127.0.0.1,[::1]
MCP_LEGACY_MODE=stateless
MCP_MAX_REQUEST_BYTES=1048576

# MCP client access is separate from the Resend provider key.
# Existing BEARER_TOKEN remains accepted as a compatibility alias.
MCP_AUTH_MODE=static-bearer
MCP_BEARER_TOKEN=replace-with-random-client-access-token

# To use OAuth Resource Server mode instead, set MCP_AUTH_MODE=oauth and configure:
# OAUTH_ISSUER_URL=https://auth.example.com
# OAUTH_AUTHORIZATION_URL=https://auth.example.com/authorize
# OAUTH_TOKEN_URL=https://auth.example.com/token
# OAUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# OAUTH_AUDIENCE=http://localhost:3000/mcp
# OAUTH_REQUIRED_SCOPES=mcp:resend

# Provider credentials (server-side only)
RESEND_API_KEY=re_your_resend_api_key
RESEND_DEFAULT_FROM=newsletter@yourdomain.com
# Optional comma-separated exact addresses or @domain patterns
RESEND_ALLOWED_RECIPIENTS=
RPS_LIMIT=2
CONCURRENCY_LIMIT=2
